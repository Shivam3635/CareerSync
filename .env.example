# Django Backend Configuration
DJANGO_SECRET_KEY=careersync-production-secret-key-change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# AI Assisted Job Posting (Gemini API)
# Optional: Provide a Google Gemini API key to enable LLM structured extraction.
# If omitted, CareerSync automatically falls back to its deterministic regex & rules extraction engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
# Leave POSTGRES_DB commented or blank to use SQLite out of the box,
# or uncomment to connect to your PostgreSQL instance:
# POSTGRES_DB=careersync_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Email Configuration
# By default in development, emails are printed to the console:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_api_key
